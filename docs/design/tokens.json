{
  "$description": "Single source of design tokens for CAPIE (Cyprian's API Extender) and the mods built on it, starting with Rename Anything. One palette, one type, motion and icon system for both; the products differ only in name and mark (see 'product'). Hex values marked 'sampled' were measured read-only from the installed HOI4 1.19.3.0 textures; 'game' values are copied from the textcolors table in interface/core.gfx; 'web' values are adjusted for WCAG contrast. Paths in 'from' are relative to a HOI4 installation. Format: W3C Design Tokens draft ($value/$type).",
  "meta": {
    "version": "1.1.0",
    "game": "Hearts of Iron IV 1.19.3.0 (Windows, Steam)",
    "sources": {
      "textcolors": "interface/core.gfx lines 797-821",
      "fonts": "gfx/fonts/*.fnt info headers",
      "samples": "median and highlight pixels of gfx/interface textures listed per token"
    }
  },
  "color": {
    "surface": {
      "window-ink": {
        "$type": "color",
        "$value": "#0f0e0d",
        "origin": "sampled",
        "from": "gfx/interface/tiles/tiled_window_2b_border.dds (median)",
        "use": "Deepest backdrop. Outer frame of web panels."
      },
      "field-ink": {
        "$type": "color",
        "$value": "#161412",
        "origin": "web",
        "from": "between window-ink and panel-umber",
        "use": "Recessed areas: text fields, diagram nodes, code-like plates."
      },
      "panel-umber": {
        "$type": "color",
        "$value": "#272421",
        "origin": "sampled",
        "from": "gfx/interface/generic_bg2.dds (median)",
        "use": "Panel and editor background. Diagram canvas."
      },
      "panel-rim": {
        "$type": "color",
        "$value": "#3c3936",
        "origin": "sampled",
        "from": "tiled_window_2b_border.dds (p98)",
        "use": "Hairline borders and dividers."
      },
      "steel-shadow": {
        "$type": "color",
        "$value": "#3c3b38",
        "origin": "sampled",
        "from": "equipmentdesigner/edit_notes_button.dds (median)",
        "use": "Icon frame body."
      },
      "steel-bevel": {
        "$type": "color",
        "$value": "#76776b",
        "origin": "sampled",
        "from": "button_123x34.dds (p98)",
        "use": "Icon frame highlight, neutral node strokes, connector lines."
      }
    },
    "olive": {
      "olive-button": {
        "$type": "color",
        "$value": "#2e3627",
        "origin": "sampled",
        "from": "button_123x34.dds (median)",
        "use": "Button and 'works today' chip fill."
      },
      "olive-lit": {
        "$type": "color",
        "$value": "#424e38",
        "origin": "sampled",
        "from": "button_123x34.dds (p90)",
        "use": "Button hover, chip stroke."
      },
      "pencil-green": {
        "$type": "color",
        "$value": "#406030",
        "origin": "sampled",
        "from": "edit_notes_button.dds frame 1 (dominant saturated)",
        "use": "Edit affordance: the notepad of the pencil icon."
      },
      "pencil-green-lit": {
        "$type": "color",
        "$value": "#507040",
        "origin": "sampled",
        "from": "edit_notes_button.dds frame 1",
        "use": "Pencil highlight, 'today' square in legends."
      }
    },
    "brass": {
      "brass": {
        "$type": "color",
        "$value": "#d0a070",
        "origin": "sampled",
        "from": "closebutton_16.dds (brightest saturated)",
        "use": "The native layer: library outline in diagrams, badge rims, 'planned' tag text."
      },
      "brass-dim": {
        "$type": "color",
        "$value": "#908060",
        "origin": "sampled",
        "from": "closebutton_16.dds (mid)",
        "use": "Dashed outline of planned items. Strokes only, never small text."
      }
    },
    "text": {
      "parchment": {
        "$type": "color",
        "$value": "#ece6d3",
        "origin": "web",
        "game": "§W / §T (255 255 255)",
        "use": "Primary text on web. In game use the default white."
      },
      "khaki": {
        "$type": "color",
        "$value": "#c3b091",
        "origin": "game",
        "game": "§L (195 176 145)",
        "use": "Secondary text, hints, neutral status line."
      },
      "ash": {
        "$type": "color",
        "$value": "#a39a86",
        "origin": "web",
        "game": "§g (176 176 176) in game",
        "use": "Muted text, captions, disabled labels."
      },
      "header-amber": {
        "$type": "color",
        "$value": "#ffbd00",
        "origin": "game",
        "game": "§H / §Y (255 189 0)",
        "use": "Section labels and highlighted values. Sparingly."
      }
    },
    "signal": {
      "go-green": {
        "$type": "color",
        "$value": "#7db35a",
        "origin": "web",
        "game": "§G (0 159 3)",
        "use": "Works today, success. In game use §G."
      },
      "alarm-red": {
        "$type": "color",
        "$value": "#ff3232",
        "origin": "game",
        "game": "§R (255 50 50)",
        "use": "Errors and blocking conditions. On web place on field-ink only (5.0:1)."
      },
      "caution-orange": {
        "$type": "color",
        "$value": "#ff7019",
        "origin": "game",
        "game": "§O (255 112 25)",
        "use": "API not loaded, fallback paths, unknown game version."
      },
      "warning-rust": {
        "$type": "color",
        "$value": "#c64811",
        "origin": "sampled",
        "from": "gfx/interface/warning_icon.dds (median)",
        "use": "Warning glyph fill and fallback strokes."
      }
    }
  },
  "font": {
    "game": {
      "field": {
        "$type": "fontFamily",
        "$value": "hoi_18",
        "face": "Ubuntu Light (bitmap, 18 px)",
        "polish": true,
        "use": "Text typed into a native edit box."
      },
      "title": {
        "$type": "fontFamily",
        "$value": "hoi_18mbs",
        "face": "Ubuntu Bold (bitmap, 18 px)",
        "polish": true,
        "use": "Names shown next to a pencil, editor titles."
      },
      "label": {
        "$type": "fontFamily",
        "$value": "hoi_16mbs",
        "face": "Ubuntu Bold (bitmap, 16 px)",
        "polish": true,
        "use": "Buttons, tabs, short labels."
      },
      "status": {
        "$type": "fontFamily",
        "$value": "Arial12",
        "face": "Arial (bitmap, 14 px line)",
        "polish": true,
        "use": "One-line status and error text under fields."
      },
      "tooltip": {
        "$type": "fontFamily",
        "$value": "ToolTip_Font",
        "face": "Garamond 16 (vanilla, set by the game)",
        "polish": "game-managed",
        "use": "All tooltips. Never override."
      }
    },
    "web": {
      "sans": {
        "$type": "fontFamily",
        "$value": "Ubuntu, 'Segoe UI', 'DejaVu Sans', Verdana, sans-serif",
        "use": "All web UI text. Ubuntu is the face behind the game's hoi_* fonts and ships under the free Ubuntu Font Licence; load it only where external fonts are allowed (release pages). SVGs on GitHub fall back to installed fonts."
      },
      "serif": {
        "$type": "fontFamily",
        "$value": "'EB Garamond', Garamond, Georgia, 'Times New Roman', serif",
        "use": "Tooltip-like asides and quotations, echoing the game's Garamond tooltips."
      },
      "mono": {
        "$type": "fontFamily",
        "$value": "'Ubuntu Mono', Consolas, 'DejaVu Sans Mono', monospace",
        "use": "Code, hashes, CLI output only."
      }
    }
  },
  "typography": {
    "label-caps": {
      "fontFamily": "{font.web.sans}",
      "fontSize": "11.5px",
      "fontWeight": 700,
      "letterSpacing": "0.14em",
      "textTransform": "uppercase",
      "use": "Diagram section labels in header-amber. Evokes the game's Orator headers without using them."
    },
    "node-title": {
      "fontFamily": "{font.web.sans}",
      "fontSize": "15px",
      "fontWeight": 700,
      "lineHeight": "18px"
    },
    "node-body": {
      "fontFamily": "{font.web.sans}",
      "fontSize": "12px",
      "fontWeight": 400,
      "lineHeight": "18px"
    },
    "tag": {
      "fontFamily": "{font.web.sans}",
      "fontSize": "10px",
      "fontWeight": 700,
      "letterSpacing": "0.08em",
      "textTransform": "uppercase"
    },
    "tooltip": {
      "fontFamily": "{font.web.serif}",
      "fontSize": "13px",
      "fontWeight": 400,
      "lineHeight": "17px"
    }
  },
  "size": {
    "game": {
      "pencil": {
        "$type": "dimension",
        "$value": "20px",
        "note": "30 px vanilla frame at scale 0.67"
      },
      "pencil-gap": {
        "$type": "dimension",
        "$value": "4px",
        "note": "Minimum gap between name text and pencil"
      },
      "apply-icon": {
        "$type": "dimension",
        "$value": "20px"
      },
      "cancel-icon": {
        "$type": "dimension",
        "$value": "16px"
      },
      "editor-width": {
        "$type": "dimension",
        "$value": "420px"
      },
      "field-frame": {
        "$type": "dimension",
        "$value": "364x26px"
      },
      "field-box": {
        "$type": "dimension",
        "$value": "356x20px",
        "note": "32 x widest hoi_18 glyph = 352 px"
      },
      "field-inset": {
        "$type": "dimension",
        "$value": "4px 3px"
      },
      "status-line": {
        "$type": "dimension",
        "$value": "408x14px"
      },
      "row-pitch": {
        "$type": "dimension",
        "$value": "30px"
      },
      "tab": {
        "$type": "dimension",
        "$value": "94x31px"
      },
      "max-chars": {
        "$type": "number",
        "$value": 32
      }
    },
    "web": {
      "radius-panel": {
        "$type": "dimension",
        "$value": "6px"
      },
      "radius-node": {
        "$type": "dimension",
        "$value": "2px"
      },
      "stroke-hair": {
        "$type": "dimension",
        "$value": "1px"
      },
      "stroke-node": {
        "$type": "dimension",
        "$value": "1.25px"
      },
      "stroke-ours": {
        "$type": "dimension",
        "$value": "1.75px"
      },
      "dash-planned": {
        "$type": "dimension",
        "$value": "5 4"
      },
      "space-1": {
        "$type": "dimension",
        "$value": "4px"
      },
      "space-2": {
        "$type": "dimension",
        "$value": "8px"
      },
      "space-3": {
        "$type": "dimension",
        "$value": "14px"
      },
      "space-4": {
        "$type": "dimension",
        "$value": "24px"
      },
      "space-5": {
        "$type": "dimension",
        "$value": "32px"
      },
      "diagram-width": {
        "$type": "dimension",
        "$value": "880px"
      }
    }
  },
  "motion": {
    "ease-settle": {
      "$type": "cubicBezier",
      "$value": [
        0.16,
        1,
        0.3,
        1
      ],
      "use": "Things arriving and stopping: pulses, cursor, highlights."
    },
    "ease-linear": {
      "$type": "cubicBezier",
      "$value": [
        0,
        0,
        1,
        1
      ],
      "use": "Timeline keyframes that only switch visibility."
    },
    "loop-short": {
      "$type": "duration",
      "$value": "3200ms",
      "use": "Data pulses between layers."
    },
    "loop-story": {
      "$type": "duration",
      "$value": "10000ms",
      "use": "A full user story (edit in place)."
    },
    "loop-chain": {
      "$type": "duration",
      "$value": "12000ms",
      "use": "Two-branch flows (launch chain)."
    },
    "rest-min": {
      "$type": "number",
      "$value": 0.2,
      "use": "At least 20 % of every loop is still."
    },
    "pulse-radius": {
      "$type": "dimension",
      "$value": "3.5px"
    }
  },
  "status": {
    "today": {
      "fill": "{color.olive.pencil-green-lit}",
      "text": "{color.signal.go-green}",
      "stroke": "solid",
      "label": {
        "en": "Works today",
        "pl": "Działa"
      }
    },
    "in-progress": {
      "fill": "none",
      "text": "{color.text.header-amber}",
      "stroke": "{color.text.header-amber}",
      "label": {
        "en": "In progress",
        "pl": "W toku"
      }
    },
    "planned": {
      "fill": "none",
      "text": "{color.brass.brass}",
      "stroke": "{color.brass.brass-dim} dashed",
      "label": {
        "en": "Planned",
        "pl": "Planowane"
      }
    },
    "not-supported": {
      "fill": "none",
      "text": "{color.signal.caution-orange}",
      "stroke": "{color.signal.warning-rust}",
      "label": {
        "en": "Not supported",
        "pl": "Nieobsługiwane"
      }
    }
  },
  "product": {
    "capie": {
      "name": "CAPIE",
      "fullName": "Cyprian's API Extender",
      "firstMention": "CAPIE (Cyprian's API Extender)",
      "mark": "connector",
      "endorsement": {
        "en": "Built on CAPIE",
        "pl": "Zbudowane na CAPIE"
      }
    },
    "rename-anything": {
      "name": "Rename Anything",
      "firstMention": "Rename Anything",
      "mark": "pencil",
      "builtOn": "capie"
    }
  }
}
