spriteTypes = {
	spriteType = { name = "GFX_capie_spike_s1"   texturefile = "gfx/interface/goals/goal_unknown.dds" }
	spriteType = { name = "GFX_capie_spike_s2_0" texturefile = "gfx/interface/goals/goal_unknown.dds" }
	spriteType = { name = "GFX_capie_spike_s2_1" texturefile = "gfx/interface/goals/goal_generic_construct_infrastructure.dds" }
}