# CAPIE C++ formatting. clang-format 17+ (any LLVM build, or the VS "C++ Clang tools" component).
# Not run in stage 2: clang-format is not installed on the build machine (see the stage-2 report).
# Run: clang-format -i --style=file plugin/capie/src/**/*.hpp plugin/capie/src/**/*.cpp
BasedOnStyle: Google
Language: Cpp
Standard: c++20
ColumnLimit: 120
IndentWidth: 4
AccessModifierOffset: -4
NamespaceIndentation: None
FixNamespaceComments: true
PointerAlignment: Left
DerivePointerAlignment: false
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never
BreakBeforeBraces: Attach
IncludeBlocks: Regroup
IncludeCategories:
  # 1. own headers ("..."), 2. <windows.h> (must precede every other Win32 header),
  # 3. other Win32 and third-party headers (<bcrypt.h>, <tlhelp32.h>, <MinHook.h>), 4. standard library.
  - Regex: '^"'
    Priority: 1
  - Regex: '^<windows\.h>'
    Priority: 2
  - Regex: '^<(bcrypt|tlhelp32|MinHook)\.h>'
    Priority: 3
  - Regex: '^<'
    Priority: 4
SortIncludes: CaseSensitive
IncludeIsMainRegex: '$'
SpacesBeforeTrailingComments: 2
ReflowComments: true
# Signature hex strings stay one literal each (grep-able against the RE evidence and parsed by
# tests/check_signature_table.py); lines may exceed the column limit for them.
BreakStringLiterals: false
