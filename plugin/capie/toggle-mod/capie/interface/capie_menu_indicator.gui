# CAPIE switch mod: one status line in the main menu (bottom right corner).
#
# No vanilla file is overridden. "frontend_alpha_stamp" is a front-end window name that
# hoi4.exe looks up; vanilla 1.19.3 keeps its definition commented out in
# interface/frontendmainview.gui, so this new file supplies it. Whether the engine still
# creates that window in release builds is UNTESTED (see the in-game checklist).
#
# The text is the CAPIE status key. CAPIE answers it while it is loaded ("CAPIE 1.3");
# without CAPIE the localisation fallback of this mod is shown ("CAPIE missing").
guiTypes = {
	containerWindowType = {
		name = "frontend_alpha_stamp"
		position = { x = -16 y = -12 }
		size = { width = 360 height = 18 }
		orientation = lower_right
		origo = lower_right
		clipping = no

		instantTextBoxType = {
			name = "capie_menu_status"
			position = { x = 0 y = 2 }
			textureFile = ""
			font = "Arial12"
			borderSize = { x = 0 y = 0 }
			text = "CAPIE_STATUS"
			format = right
			maxWidth = 360
			maxHeight = 14
		}
	}
}