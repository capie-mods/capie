# CAPIE clang-tidy configuration (clang-tidy 17+). Run with tools/run-clang-tidy.ps1, which
# uses plugin/build/capie/compile_commands.json written by build.ps1.
#
# Every disabled check has its reason here; single-site exceptions use NOLINT with a reason.
#  - cppcoreguidelines-pro-type-reinterpret-cast, -pro-bounds-pointer-arithmetic,
#    -pro-type-union-access, -pro-bounds-constant-array-index:
#      CAPIE reads foreign engine objects by address. Turning an RVA or offset into an
#      address, and the MSVC std::string union, are the purpose of the engine adapter layer;
#      every such access goes through the bounded, SEH-guarded readers in core/memory.hpp.
#  - cppcoreguidelines-pro-type-vararg, cppcoreguidelines-pro-bounds-array-to-pointer-decay:
#      std::snprintf into fixed stack buffers is the allocation-free log formatter used on
#      event paths (no heap, no exceptions inside hooks).
#  - cppcoreguidelines-avoid-non-const-global-variables:
#      MinHook detours are free functions; the hook state (trampolines, lifecycle, flags)
#      is process-global by construction. Each global is documented and owned by one module.
#  - modernize-avoid-c-arrays, cppcoreguidelines-avoid-c-arrays:
#      engine POD layouts must match game memory byte for byte, and the constexpr name
#      tables are referenced by the accepted test suites as arrays.
#  - modernize-use-trailing-return-type: style preference, not adopted.
#  - readability-identifier-length: loop indices (i, j) and short math names in ported code.
#  - readability-implicit-bool-conversion:
#      the caption/focus cores keep the reviewed rev7 form (pointer/flag truthiness) so the
#      78 mutation anchors and review diffs stay small.
#  - bugprone-easily-swappable-parameters: signatures mirror game functions and hook ABIs.
#  - misc-non-private-member-variables-in-classes: plain data structs.
#  - cppcoreguidelines-macro-usage: the one flavor macro (CAPIE_DEBUG_DIAGNOSTICS) is a build switch.
#  - misc-include-cleaner: headers include what the unity composition roots need.
#  - portability-avoid-pragma-once: the only targets are MSVC and clang-cl on Windows, both
#    support `#pragma once`; include guards would add a second naming scheme for nothing.
#  - performance-no-int-to-ptr: engine addresses are integers by nature (image base + RVA,
#    object + offset); turning them into pointers is the job of the engine adapter layer and
#    every resulting pointer is only read through the bounded readers.
#  - modernize-use-designated-initializers: the signature table, schema tables and log
#    tables are dense positional rows documented by their struct fields; designated
#    initializers would triple the width of every row, and check_signature_table.py parses
#    the positional form to compare it with the accepted sources.
#  - performance-enum-size: none of these enums is stored in arrays or hot structures;
#    InitCode must stay 32-bit (it is the DWORD exit code), and narrowing the others only
#    adds casts at the printf call sites.
#  - cppcoreguidelines-pro-bounds-avoid-unchecked-container-access: every std::array index
#    is bounded by its loop or by a modulo of the array size; .at() would add throwing paths
#    to noexcept hook code.
#  - cppcoreguidelines-avoid-const-or-ref-data-members: the caption/focus services hold a
#    reference to their environment adapter, which outlives them (both are process globals);
#    a pointer would only add a null state that cannot occur.
#  - bugprone-exception-escape is kept: hook bodies are noexcept and catch(...) internally.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  cert-*,
  clang-analyzer-*,
  concurrency-*,
  cppcoreguidelines-*,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-type-union-access,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -cppcoreguidelines-pro-type-vararg,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-avoid-non-const-global-variables,
  -cppcoreguidelines-avoid-c-arrays,
  -cppcoreguidelines-macro-usage,
  -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,
  -cppcoreguidelines-avoid-const-or-ref-data-members,
  google-build-using-namespace,
  google-explicit-constructor,
  misc-*,
  -misc-non-private-member-variables-in-classes,
  -misc-include-cleaner,
  modernize-*,
  -modernize-use-designated-initializers,
  -modernize-use-trailing-return-type,
  -modernize-avoid-c-arrays,
  performance-*,
  -performance-no-int-to-ptr,
  -performance-enum-size,
  portability-*,
  -portability-avoid-pragma-once,
  readability-*,
  -readability-identifier-length,
  -readability-implicit-bool-conversion
WarningsAsErrors: '*'
HeaderFilterRegex: 'plugin[/\\]capie[/\\]src[/\\].*'
FormatStyle: file
CheckOptions:
  - key: misc-const-correctness.WarnPointersAsPointers
    # Game functions take non-const pointers (void*, widget*); pointee-const suggestions do
    # not fit the engine ABI. Pointers themselves (`T* const`) are still checked.
    value: false
  - key: readability-function-cognitive-complexity.Threshold
    # Guard chains are long linear && sequences; 60 keeps them while catching real nesting.
    value: 60
  - key: readability-magic-numbers.IgnoredIntegerValues
    value: '0;1;2;3;4;8;10;16'
  - key: cppcoreguidelines-avoid-magic-numbers.IgnoredIntegerValues
    value: '0;1;2;3;4;8;10;16'
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case
  - key: readability-identifier-naming.FunctionCase
    value: lower_case
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.EnumCase
    value: CamelCase
  - key: readability-identifier-naming.EnumConstantCase
    value: lower_case
  - key: readability-identifier-naming.PrivateMemberSuffix
    value: '_'
