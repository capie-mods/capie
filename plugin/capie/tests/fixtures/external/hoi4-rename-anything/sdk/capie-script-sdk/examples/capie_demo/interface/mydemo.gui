# CAPIE demo: editor windows. Names follow the CAPIE grammar; fonts draw the whole CAPIE
# alphabet (hoi_18, hoi_16mbs). Fields are 356 px wide, enough for 32 of the widest glyph.
guiTypes = {
	containerWindowType = {
		name = "capie_v1_ed__capiedemo__motto"
		position = { x = -210 y = -90 }
		orientation = center
		size = { width = 420 height = 150 }
		clipping = no
		background = { name = "Background" quadTextureSprite = "GFX_tiled_window_2b_border" }
